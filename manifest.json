{
  "manifest_version": 2,
  "name": "Visit Logger",
  "version": "1.1",
  "browser_specific_settings": {
    "gecko": {
      "id": "visit-logger@example.com",
      "strict_min_version": "140.0"
    }
  },
  "description": "Manages website visits during a job search workflow.",
  "developer": {
    "name": "Andriy Palamarchuk"
  },

  "icons": {
    "48": "icons/logged.svg",
    "96": "icons/logged.svg"
  },

  "permissions": [
    "<all_urls>",
    "activeTab",
    "clipboardWrite",
    "downloads",
    "menus",
    "storage",
    "tabs",
    "unlimitedStorage"
  ],

  "browser_action": {
    "default_icon": "icons/not-logged.svg",
    "default_title": "Log site visit (F9)"
  },

  "commands": {
    "copy-contact": {
      "suggested_key": { "default": "F8" },
      "description": "Generate and copy into clipboard a \"contact\" record for the current web site"
    },
    "_execute_browser_action": {
      "suggested_key": { "default": "F9" },
      "description": "Marks the site as visited and after that toggles the R badge for the toolbar icon"
    },
    "open-first-careers-link": {
      "suggested_key": { "default": "Ctrl+Alt+J" },
      "description": "Follows the first careers link listed in the highlight panel"
    }
  },

  "background": {
    "scripts": ["ats-hosts.js", "terms.js", "matcher.js", "background.js"]
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["ats-hosts.js", "terms.js", "matcher.js", "highlighter.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
